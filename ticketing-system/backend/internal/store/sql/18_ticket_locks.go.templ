{{define "ticket_locks_acquire.sql"}}
INSERT INTO ticket_locks (ticket_id, locked_by, locked_by_name, acquired_at, expires_at)
VALUES ($1, $2, $3, now(), now() + $4::interval)
ON CONFLICT (ticket_id) DO UPDATE
    SET locked_by = $2, locked_by_name = $3, acquired_at = now(), expires_at = now() + $4::interval
    WHERE ticket_locks.expires_at < now() OR ticket_locks.locked_by = $2
RETURNING ticket_id, locked_by, locked_by_name, acquired_at, expires_at
{{end}}

{{define "ticket_locks_get.sql"}}
SELECT ticket_id, locked_by, locked_by_name, acquired_at, expires_at
FROM ticket_locks
WHERE ticket_id = $1 AND expires_at > now()
{{end}}

{{define "ticket_locks_renew.sql"}}
UPDATE ticket_locks
SET expires_at = now() + $3::interval
WHERE ticket_id = $1 AND locked_by = $2 AND expires_at > now()
RETURNING ticket_id, locked_by, locked_by_name, acquired_at, expires_at
{{end}}

{{define "ticket_locks_release.sql"}}
DELETE FROM ticket_locks
WHERE ticket_id = $1 AND locked_by = $2
{{end}}

{{define "ticket_locks_delete_expired.sql"}}
DELETE FROM ticket_locks
WHERE expires_at < now()
{{end}}
