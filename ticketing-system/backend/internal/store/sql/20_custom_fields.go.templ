{{define "custom_fields_by_project.sql"}}
SELECT id, project_id, name, label, field_type, options, "order", required, created_at, updated_at
FROM custom_fields
WHERE project_id = $1
ORDER BY "order", created_at
{{end}}

{{define "custom_field_by_id.sql"}}
SELECT id, project_id, name, label, field_type, options, "order", required, created_at, updated_at
FROM custom_fields
WHERE id = $1 AND project_id = $2
{{end}}

{{define "custom_field_insert.sql"}}
INSERT INTO custom_fields (project_id, name, label, field_type, options, "order", required)
VALUES ($1, $2, $3, $4, $5::jsonb,
    (SELECT COALESCE(MAX("order") + 1, 0) FROM custom_fields WHERE project_id = $1),
    $6)
RETURNING id, project_id, name, label, field_type, options, "order", required, created_at, updated_at
{{end}}

{{define "custom_field_update.sql"}}
UPDATE custom_fields
SET label = $3, options = $4::jsonb, required = $5, updated_at = now()
WHERE id = $1 AND project_id = $2
RETURNING id, project_id, name, label, field_type, options, "order", required, created_at, updated_at
{{end}}

{{define "custom_field_reorder.sql"}}
UPDATE custom_fields SET "order" = $3, updated_at = now()
WHERE id = $1 AND project_id = $2
{{end}}

{{define "custom_field_delete.sql"}}
DELETE FROM custom_fields WHERE id = $1 AND project_id = $2
{{end}}

{{define "custom_field_schemas_by_field.sql"}}
SELECT field_id, ticket_type, required_state_ids
FROM custom_field_schemas
WHERE field_id = $1
{{end}}

{{define "custom_field_schemas_by_project.sql"}}
SELECT cfs.field_id, cfs.ticket_type, cfs.required_state_ids
FROM custom_field_schemas cfs
JOIN custom_fields cf ON cf.id = cfs.field_id
WHERE cf.project_id = $1
{{end}}

{{define "custom_field_schemas_delete_by_field.sql"}}
DELETE FROM custom_field_schemas WHERE field_id = $1
{{end}}

{{define "custom_field_schema_upsert.sql"}}
INSERT INTO custom_field_schemas (field_id, ticket_type, required_state_ids)
VALUES ($1, $2, $3::jsonb)
ON CONFLICT (field_id, ticket_type) DO UPDATE SET required_state_ids = EXCLUDED.required_state_ids
{{end}}

{{define "ticket_custom_field_values_by_ticket.sql"}}
SELECT tcfv.ticket_id, tcfv.field_id, cf.name, cf.label, cf.field_type,
       tcfv.value_text, tcfv.value_number, tcfv.value_date, tcfv.value_boolean, tcfv.value_user_id
FROM ticket_custom_field_values tcfv
JOIN custom_fields cf ON cf.id = tcfv.field_id
WHERE tcfv.ticket_id = $1
ORDER BY cf."order", cf.created_at
{{end}}

{{define "ticket_custom_field_value_upsert.sql"}}
INSERT INTO ticket_custom_field_values (ticket_id, field_id, value_text, value_number, value_date, value_boolean, value_user_id)
VALUES ($1, $2, $3, $4, $5, $6, $7)
ON CONFLICT (ticket_id, field_id) DO UPDATE SET
    value_text    = EXCLUDED.value_text,
    value_number  = EXCLUDED.value_number,
    value_date    = EXCLUDED.value_date,
    value_boolean = EXCLUDED.value_boolean,
    value_user_id = EXCLUDED.value_user_id
{{end}}

{{define "ticket_custom_field_values_clear.sql"}}
DELETE FROM ticket_custom_field_values WHERE ticket_id = $1
{{end}}
